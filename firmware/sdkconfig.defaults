# Merzarkabul Airplay Speakers build defaults. Everything here is a project
# decision, not a preference: changing a line usually means a document or an
# ADR changes too.

# --- Target and module: ESP32-S3 N16R8, 16 MB flash + 8 MB octal PSRAM (ADR-0010)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Partition layout (ADR-0008 needs two equal app slots)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA rollback stays OFF until F7.
#     With rollback enabled an image is pending until the application calls
#     esp_ota_mark_app_valid_cancel_rollback(). F0 has no first-boot health
#     check to base that call on, so enabling it now would mean the first OTA
#     rolls back every time. It is turned on together with the health check
#     described in docs/03-firmware/ota-and-release-plan.md.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

# --- Audio is the real-time path. Keep the tick fast enough to schedule it and
#     leave both cores available; the final task/core placement is decided by
#     measurement in F2, not here.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Build hygiene: warnings that hide real defects are errors.
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Bluetooth, for the BLE provisioning transport (ADR-0005 option C).
#     NimBLE rather than Bluedroid: this product only ever needs BLE, and
#     NimBLE is markedly smaller. The stack is released again as soon as
#     provisioning ends, so it costs flash but not steady-state RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- Diagnostics must never carry credentials (docs/03-firmware/security-and-recovery.md)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- TLS kok sertifikalari. Varsayilan paket FULL kalir; uzerine certs/
#     dizinindeki ek kokler bindirilir. Neden gerektigi certs/README.md'de
#     olculmus haliyle duruyor: GitHub'in release varlik sunucusu ISRG Root YR
#     altinda ve o kok ESP-IDF v5.5.1 paketinde yok.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/isrg-root-yr.pem"

# --- Uygulama imzasi burada ACIK DEGIL, bilerek. Acildiginda ESP-IDF acilista
#     esp_secure_boot_init_checks() -> check_signature_on_update_check() yolunu
#     isletir ve imzasiz bir uygulamada abort() eder; yani duz "idf.py flash"
#     ile derlenen bir gelistirme yapisi boot dongusune girer. Imzalama yalniz
#     imzalama adiminin ayni is icinde kesin calistigi surum yolunda acilir:
#     sdkconfig.release. Ayrinti ADR-0008'de.

# The AirPlay receiver, vendored at the commit ADR-0007 pins. On by default now
# that the product is meant to be an AirPlay speaker; it still refuses to run
# until a driver-protection profile exists, so compiling it in does not open the
# audio path. Enabling it binds the whole firmware to upstream's non-commercial
# licence, which ADR-0007 accepted.
CONFIG_HK_AIRPLAY=y

# The part runs at 240 MHz, not the 160 MHz default.
#
# The DSP budget is what forces this. With the CONFIG_HK_AIRPLAY_OUTPUT_DSP
# backend the playout task runs the whole protection chain per sample at
# 44.1 kHz -- mono downmix, EQ, the subsonic high-pass, an LR4 crossover into
# two branches and a limiter on each -- and it runs it between the receiver's
# decode and the I2S DMA deadline, on a core it shares with Wi-Fi and the RTSP
# session. Headroom there is what separates
# a clean stream from an underrun that sounds like a DAC fault. The cost is a
# little heat on a part fed from a desktop adapter, which is the right way
# round: a speaker that is awake is already spending far more on its amplifier
# and its radio than on its core clock. Revisit with a measured task-time
# figure, not by reasoning.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
