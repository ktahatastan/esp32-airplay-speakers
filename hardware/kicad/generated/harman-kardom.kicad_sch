	(text "Set the PD trigger to 20 V and calibrate the XL4015 to 16.80 V / 2.00 A WITH THE BATTERY DISCONNECTED."
		(exclude_from_sim no)
		(at 30.48 60.96 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f364bd1f-6004-55a6-8a45-c1431136917c")
	)
	(text "XL4015 HAS NO GUARANTEED CHARGE TERMINATION. Measure the CV current decay at G4; no unattended charging before that."
		(exclude_from_sim no)
		(at 30.48 66.04 0.0000)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
		)
		(uuid "c021a93c-cf4b-5fd5-8a21-44266689f866")
	)
	(text "BMS pin order is logical. Verify silkscreen, real continuous current, balance threshold/current and NTC behaviour before wiring."
		(exclude_from_sim no)
		(at 210.82 60.96 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a3632300-c5c3-52de-b46e-f85759a8bcc9")
	)
	(text "D2 and R2 stay DNP: the switch lamp is a 12 V part and is never connected directly to the 16.8 V rail."
		(exclude_from_sim no)
		(at 210.82 63.5 0.0000)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
		)
		(uuid "6f691b65-48a5-5065-8215-cbad9c2b4edb")
	)
	(text "Adjust U4 to 5.10 V before connecting the ESP32 and DAC. Keep JP1 open while programming over USB."
		(exclude_from_sim no)
		(at 27.94 132.08 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f1d76f3c-9f46-5525-bb38-d9ef048c0b79")
	)
	(text "TP9 target: <=50 mVpp under normal load; the 5 V rail must not dip below 4.75 V on Wi-Fi current bursts."
		(exclude_from_sim no)
		(at 27.94 137.16 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "032cf20c-e5a8-5aa5-a98c-4ba16d5177d0")
	)
	(text "Button, LED and I2C wiring is kept away from the Class-D speaker cables. GPIO assignment is a candidate until the board schematic and a boot test exist."
		(exclude_from_sim no)
		(at 129.54 182.88 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9da98ebd-6bee-58a9-af3a-1ad5f43cc0ff")
	)
	(text "Series resistors are DNP if the purchased RGB module already carries them."
		(exclude_from_sim no)
		(at 129.54 185.42 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f19072c5-fea1-5bed-b7ff-033049a94ed7")
	)
	(text "DANGER: AMP_L_MINUS and AMP_R_MINUS are BTL switching outputs, not ground. Never clip a scope ground to them."
		(exclude_from_sim no)
		(at 210.82 137.16 0.0000)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
		)
		(uuid "05ee459d-2be2-5672-8bc6-4560c8cb7ba2")
	)
	(text "C_SAFE is not a crossover. It is the last line of defence behind the DSP high-pass and limiter; its value comes from the G2 report."
		(exclude_from_sim no)
		(at 210.82 142.24 0.0000)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
		)
		(uuid "e107d56f-d2d1-5686-ad56-4975e2dfdc95")
	)
	(text "Left digital channel drives the woofer path, right drives the tweeter path. This is a bi-amp split of one mono program, not a stereo box."
		(exclude_from_sim no)
		(at 210.82 144.78 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "17f0f440-7a38-5e8e-ab3e-c1a90d680295")
	)
	(text "Scope ground goes to POWER_GND or STAR_GND only. For BTL outputs use a differential probe, or two 10x probes with BOTH ground clips on TP6 and MATH = CH1 - CH2."
		(exclude_from_sim no)
		(at 30.48 246.38 0.0000)
