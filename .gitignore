# Build and tool output
build/
build-release/
dist/
.pio/
.cache/
.tmp/
*.log

# OS/editor noise
Thumbs.db
.DS_Store
*.swp
.claude/settings.local.json

# Firmware signing keys never enter the repository. They are generated offline
# and live only in the protected 'release' GitHub environment (ADR-0008).
# firmware/certs/*.pem is deliberately NOT covered: those are public root
# certificates, not keys.
*signing_key*.pem
secure_boot_signing_key*
*.pem.key

# Local secrets; commit only documented examples
.env
.env.*
!.env.example

# Obsidian is intentionally versioned for the shared project vault.
!.obsidian/
!.obsidian/**

# Host test builds
build/host-tests/

# Python bytecode
__pycache__/
*.pyc

# Generated provisioning credentials. The label files hold the only copy of
# each password; they must never be committed.
build/provisioning/
hardware/kicad/.venv/
